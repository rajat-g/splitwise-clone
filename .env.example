# Convex (realtime DB + validation, free 1M calls/mo)
# Get this from `npx convex dev` — paste the dev URL for local work,
# replace with the prod URL when deploying to Vercel.
VITE_CONVEX_URL=https://your-project.convex.cloud

# Convex Auth (email + password) — all free, no third-party keys.
# One command (any OS) to generate + set backend env vars:
#   npm run setup:auth            (dev deployment)
#   npm run setup:auth -- --prod  (production deployment)
# Manual alternative: node scripts/generate-auth-keys.mjs, then
# `npx convex env set` for JWT_PRIVATE_KEY and JWKS (see README).
